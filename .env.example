# Optional. Server-side only. Do not use a NEXT_PUBLIC_ prefix.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional server timeout in ms (1000–120000). Default 60000; host limits still apply.
GEMINI_TIMEOUT_MS=60000

# Optional exact public HTTPS origin when a reverse proxy uses an internal URL.
# Keep blank for local development. The proxy must preserve the browser's Host.
FLOWRA_PUBLIC_ORIGIN=

# Separate device-only bearer token, at least 32 random characters. Never NEXT_PUBLIC_.
# A blank value disables ingestion. Demo login credentials are not accepted here.
FLOWRA_INGEST_TOKEN=
FLOWRA_DEVICE_ID=esp32-flowra-01
